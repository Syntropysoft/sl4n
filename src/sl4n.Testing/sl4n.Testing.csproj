<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>sl4n.Testing</PackageId>
    <Version>1.0.5</Version>
    <PackageReleaseNotes>1.0.5 - fixes: the log message no longer leaks masked values (re-rendered from masked state), and DisposeAsync is idempotent so a clean host shutdown no longer throws. Plus durable-transport outage callbacks, a poison-spool-line fix, and masking that no longer slows with custom rules. See CHANGELOG.md.</PackageReleaseNotes>
    <Authors>Syntropy</Authors>
    <Company>Syntropy</Company>
    <Product>sl4n</Product>
    <Description>Testing helpers for sl4n — SpyTransport captures emitted log entries so you can assert on levels, messages, context fields and masking in unit tests.</Description>
    <PackageTags>logging;testing;masking;observability;sl4n</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Syntropysoft/sl4n</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Syntropysoft/sl4n</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\sl4n\sl4n.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
