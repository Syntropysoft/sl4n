<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The published surface builds clean, and stays that way: a warning here is a missing doc on
         a public member, or an AOT/trim warning, and both are defects in a library whose selling
         point is being documented and AOT-safe. Tests and benchmarks are deliberately NOT strict. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package identity -->
    <PackageId>sl4n.AspNetCore</PackageId>
    <Version>1.1.0</Version>
    <PackageReleaseNotes>1.0.6 - docs only: NuGet-safe README (plain Markdown header, no logo). Ships the 1.0.5 fixes: the log message no longer leaks masked values, DisposeAsync is idempotent so a clean host shutdown no longer throws, plus durable-transport outage callbacks and faster masking. See CHANGELOG.md.</PackageReleaseNotes>
    <Authors>Syntropy</Authors>
    <Company>Syntropy</Company>
    <Product>sl4n</Product>
    <Description>
      ASP.NET Core middleware for sl4n — extracts inbound context fields from HTTP headers,
      opens a propagation scope (AsyncLocal) and a MEL log scope in one step.
      NativeAOT compatible out-of-the-box.
    </Description>
    <PackageTags>logging;masking;context-propagation;aspnetcore;middleware;observability;aot</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Syntropysoft/sl4n</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Syntropysoft/sl4n</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Symbols -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\sl4n\sl4n.csproj" />
  </ItemGroup>

</Project>
