<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package identity -->
    <PackageId>sl4n</PackageId>
    <Version>1.0.6</Version>
    <PackageReleaseNotes>1.0.6 - docs only: NuGet-safe README (plain Markdown header, no logo). Ships the 1.0.5 fixes: the log message no longer leaks masked values, DisposeAsync is idempotent so a clean host shutdown no longer throws, plus durable-transport outage callbacks and faster masking. See CHANGELOG.md.</PackageReleaseNotes>
    <Authors>Syntropy</Authors>
    <Company>Syntropy</Company>
    <Product>sl4n</Product>
    <Description>
      Structured logging enrichment, declarative field masking and field-agnostic context
      propagation for .NET — built on top of Microsoft.Extensions.Logging, AsyncLocal&lt;T&gt;
      and System.Threading.Channels. NativeAOT compatible out-of-the-box.
    </Description>
    <PackageTags>logging;masking;pii;context-propagation;observability;structured-logging;opentelemetry;aot</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Syntropysoft/sl4n</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Syntropysoft/sl4n</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Symbols -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="sl4n.Tests" />
    <!-- The pipeline lives behind internal types (RawLogEvent, the worker ctor). Without this the
         only measurable surface is logger.Log(), which just writes to the channel — see
         WorkerBuildBenchmark. -->
    <InternalsVisibleTo Include="sl4n.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

</Project>
